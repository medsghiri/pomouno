rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Audio files are public readable.
    // Only authenticated users can write to prevent unauthorized uploads.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // User-specific files (future use)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
