rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // User subcollections - tasks, break reminders, sessions, etc.
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /breakReminders/{reminderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /breakReminderCompletions/{completionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // New aggregated daily stats collection
      match /dailyStats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Categories subcollections
      match /categories/tasks/items/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /categories/breakReminders/items/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Statistics subcollections
      match /statistics/{statId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Settings collection - users can read/write their own settings
    match /settings/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy collections for backward compatibility (if needed)
    // These can be removed once migration is complete
    match /sessions/{sessionId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    match /stats/{statId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    match /breakReminders/{reminderId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    match /breakReminderCompletions/{completionId} {
      allow read, update, delete: if request.auth != null && 
        request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.userId;
    }
    
    // Audio collection - public read access for audio metadata
    match /audio/{document=**} {
      allow read: if true; // Audio metadata is public
      allow write: if false; // Only admin can modify audio files
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}